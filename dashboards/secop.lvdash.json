{
  "datasets": [
    {
      "name": "934a91ff",
      "displayName": "contratos",
      "queryLines": [
        "SELECT\r\n",
        "  f.id_contrato,\r\n",
        "  f.fecha_firma,\r\n",
        "  d.anio                                  AS anio_firma,\r\n",
        "  f.valor_contrato / 1e9                  AS valor_mm,      -- miles de millones de COP\r\n",
        "  CAST(f.es_contratacion_directa AS INT)  AS es_directa,\r\n",
        "  CASE WHEN f.es_contratacion_directa THEN 'Directa' ELSE 'Competitiva' END\r\n",
        "                                          AS forma_adjudicacion,\r\n",
        "  f.modalidad_de_contratacion             AS modalidad,\r\n",
        "  f.tipo_de_contrato,\r\n",
        "  f.estado_contrato,\r\n",
        "  f.objeto_del_contrato                   AS objeto,\r\n",
        "  f.url_proceso,\r\n",
        "  e.nombre_entidad                        AS entidad,\r\n",
        "  e.departamento,\r\n",
        "  e.orden,\r\n",
        "  p.id_proveedor,\r\n",
        "  p.tipo_proveedor,\r\n",
        "  p.nombre_proveedor                      AS proveedor,\r\n",
        "  s.segmento,\r\n",
        "  s.tipo_compra\r\n",
        "FROM fct_contratos f\r\n",
        "JOIN dim_entidad   e USING (codigo_entidad)\r\n",
        "JOIN dim_proveedor p USING (id_proveedor)\r\n",
        "JOIN dim_fecha     d ON d.fecha = f.fecha_firma\r\n",
        "JOIN dim_segmento  s USING (codigo_segmento)"
      ]
    }
  ],
